# Azure SQL Server (optional - for future normalization to DB)
SQL_SERVER=wasteology.database.windows.net
SQL_DATABASE=wasteology

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=ng-reports

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDER_EMAIL=reports@wasteologygroup.com
SENDER_NAME=Wasteology Reports

# Email Recipients (comma-separated)
RECIPIENT_EMAILS=user1@example.com,user2@example.com

# Azure Function Settings (for deployment)
NG_EXCEL_PATH=/path/to/excel/file.xlsx
